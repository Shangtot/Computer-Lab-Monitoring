{
  "manifest_version": 3,
  "name": "School Lab Domain Monitor",
  "version": "1.0.0",
  "description": "Records only website domains visited on school-managed laboratory browsers.",
  "permissions": ["tabs", "storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "School Lab Domain Monitor"
  }
}
